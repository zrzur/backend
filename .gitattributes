# Prevent CRLF from breaking Docker RUN sh scripts on Linux builders (WSL/Windows checkouts).
*.sh text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Unicode reaction whitelist must stay LF — trailing CR breaks Emoji::can_use lookups.
crates/core/database/src/models/emojis/unicode_emoji.txt text eol=lf
